@{
    ViewData["Title"] = "Лоша заявка";
}

<div class="container text-center mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <img src="~/images/Cat_Error_400.png" alt="Котка, която търси нещо, но е заобиколена от боклуци - 400" class="img-fluid mb-4" style="max-width: 300px;">
            <div class="display-1 fw-bold text-warning mb-4">400</div>
            <div class="mb-4">
                <i class="bi bi-box-seam text-muted" style="font-size: 5rem;"></i>
            </div>
            <h2 class="fw-bold">Мяу? Това е твърде голямо!</h2>
            <p class="lead text-muted">
                Сървърът не успя да обработи заявката. Най-вероятно се опитвате да качите снимка,
                която надвишава лимита от 10MB, или форматът е грешен.
            </p>
            <hr class="my-4 w-25 mx-auto">
            <a href="/" class="btn btn-warning btn-lg rounded-pill px-5 shadow">
                Обратно към началото
            </a>
        </div>
    </div>
</div>