@model PurrfectShot.Web.ViewModels.Admin.UserEditInputModel
@{
    ViewData["Title"] = "Редактирай потребител";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow border-0 rounded-4">
            <div class="card-body p-5">
                <h2 class="fw-bold text-primary mb-4 text-center">@ViewData["Title"]</h2>
                <form method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" placeholder="Email" />
                        <label asp-for="Email">Имейл</label>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="UserName" class="form-control" placeholder="Username" />
                        <label asp-for="UserName">Потребителско име</label>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="NewPassword" class="form-control" type="password" placeholder="Нова парола" />
                        <label asp-for="NewPassword">Нова парола (опционално)</label>
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Потвърди" />
                        <label asp-for="ConfirmPassword">Потвърди паролата</label>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill">Запази промените</button>
                    <a asp-action="Index" asp-controller="Dashboard" class="btn btn-link w-100 mt-2 text-muted">Отказ</a>
                </form>
            </div>
        </div>
    </div>
</div>