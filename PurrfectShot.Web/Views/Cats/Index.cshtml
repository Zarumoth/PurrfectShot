@model IEnumerable<PurrfectShot.Web.ViewModels.Cats.CatCardViewModel>

@{
    ViewData["Title"] = "Запознай се с бандата";
}

<div class="container mt-4 mb-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">Нашите котки</h1>
        <p class="lead text-muted">Запознайте се с котешките членове на нашето семейство!</p>
        <hr class="w-25 mx-auto" />
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm">
            Още няма регистрирани котки. <a asp-controller="Cats" asp-action="Add">Бъди първият, който ще добави коте!</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var cat in Model)
            {
                <div class="col">
                    <partial name="_CatCardPartial" model="cat" />
                </div>
            }
        </div>
    }
</div>