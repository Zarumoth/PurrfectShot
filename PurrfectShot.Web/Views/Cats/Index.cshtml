@using PurrfectShot.Web.ViewModels.Cats
@model IEnumerable<CatCardViewModel>

@{
    ViewData["Title"] = "Запознай се с бандата";

    // Pagination and Searh
    int currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    int totalPages = (int)(ViewData["TotalPages"] ?? 1);
    string currentSearch = (string)ViewData["CurrentSearch"]!;
}


<div class="container mt-4 mb-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">Нашите котки</h1>
        <p class="lead text-muted">Запознайте се с котешките членове на нашето семейство!</p>
        <hr class="w-25 mx-auto" />
    </div>

    <!-- Breadcrumb Navigation + Add Cat Button for Authenticated Users -->
    <nav aria-label="breadcrumb" class="d-flex justify-content-between align-items-center mt-3 mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Начало</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
        </ol>
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <a asp-action="Add" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Добави Котка
            </a>
        }
    </nav>

    <!-- Search Form -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-6">
            <form method="get" asp-action="Index" class="input-group shadow-sm rounded-pill overflow-hidden border">
                <input type="text" name="search" class="form-control border-0 px-4"
                       placeholder="Търси по име или порода..." value="@currentSearch">

                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <a asp-action="Index" class="btn btn-light d-flex align-items-center px-3 border-start" title="Изчисти">
                        <i class="bi bi-x-lg text-muted"></i>
                    </a>
                }
                <button class="btn btn-primary px-4" type="submit">
                    <i class="bi bi-search"></i> Търси
                </button>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm">
            Все още няма регистрирани котки. <a asp-controller="Cats" asp-action="Add">Бъди първият, който ще добави коте!</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var cat in Model)
            {
                <div class="col">
                    <partial name="_CatCardPartial" model="cat" />
                </div>
            }
        </div>
    }

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-5">
            <ul class="pagination justify-content-center shadow-sm">

                <!-- Next -->
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-search="@currentSearch">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                <!-- Page Number Naviagtion -->
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@i"
                           asp-route-search="@currentSearch">@i</a>
                    </li>
                }

                <!-- Previous -->
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-search="@currentSearch">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
    
</div>