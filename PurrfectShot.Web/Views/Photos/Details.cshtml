@using System.Globalization
@using PurrfectShot.Web.ViewModels.Photos
@model PhotoDetailsViewModel

@{
    ViewData["Title"] = $"Снимка на {Model.CatName}";
}

<div class="container mt-4">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb bg-transparent p-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Начало</a></li>
            <li class="breadcrumb-item"><a asp-controller="Cats" asp-action="Details" asp-route-id="@Model.CatId" class="text-decoration-none text-muted">@Model.CatName</a></li>
            <li class="breadcrumb-item active" aria-current="page">Снимка</li>
        </ol>
    </nav>

    <div class="card shadow-lg border-0 overflow-hidden rounded-4">
        <div class="row g-0">

            <!-- Left Side - Picture & Heart -->
            <div class="col-md-8 bg-dark d-flex align-items-center justify-content-center position-relative" style="min-height: 500px;">
                <img src="@Model.ImageUrl" class="img-fluid" style="max-height: 800px; width: 100%; object-fit: contain;" alt="@Model.Caption">

                <!-- СЪРЦЕ (Любими) - Вече е ВЪТРЕ в контейнера на снимката -->
                <div class="position-absolute top-0 end-0 m-3" style="z-index: 5;">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <form asp-action="Favorite" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-light rounded-circle shadow border-0 p-0 btn-floating-action"
                                    style="width: 40px; height: 40px;"
                                    title="@(Model.IsFavorite ? "Премахни от любими" : "Добави в любими")">
                                @if (Model.IsFavorite)
                                {
                                    <i class="bi bi-heart-fill text-danger fs-4"></i>
                                }
                                else
                                {
                                    <i class="bi bi-heart text-danger fs-4"></i>
                                }
                            </button>
                        </form>
                    }
                </div>
            </div>

            <!-- ДЯСНА СТРАНА: ИНФО И КОНТРОЛИ -->
            <div class="col-md-4 d-flex flex-column bg-white">
                <div class="card-body p-4">

                    <!-- Actions / Header -->
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h2 class="fw-bold text-primary mb-1">@Model.CatName</h2>
                            <span class="badge rounded-pill" style="background-color: #e7f1ff; color: #0d6efd;">@Model.CatBreed</span>
                        </div>

                        <div class="d-flex align-items-center gap-1">
                            @if (Model.IsActive)
                            {
                                @if (Model.IsMainPhoto)
                                {
                                    <div class="text-success p-1" title="Това е профилната снимка">
                                        <i class="bi bi-check-square-fill fs-4"></i>
                                    </div>
                                }
                                else
                                {
                                    <form asp-action="SetProfilePicture" asp-route-id="@Model.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-link text-muted p-1 action-icon-link" title="Задай като профилна">
                                            <i class="bi bi-person-bounding-box fs-4"></i>
                                        </button>
                                    </form>
                                }

                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-link text-muted p-1 action-icon-link" title="Редактирай">
                                    <i class="bi bi-pencil-square fs-4"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-link text-danger p-1 action-icon-link" title="Изтрий">
                                    <i class="bi bi-trash fs-4"></i>
                                </a>
                            }
                            else
                            {
                                <span class="text-muted p-1" title="Профилът е архивиран - промените са забранени">
                                    <i class="bi bi-archive fs-4"></i>
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Status message if archived -->
                    @if (!Model.IsActive)
                    {
                        <div class="alert alert-secondary py-2 px-3 border-0 rounded-3 mb-4">
                            <small class="fst-italic">
                                <i class="bi bi-info-circle me-1"></i> Тази снимка е част от архивен профил.
                            </small>
                        </div>
                    }

                    <!-- Photo Caption -->
                    <div class="mb-4">
                        <p class="card-text fs-5 fst-italic text-secondary">"@Model.Caption"</p>
                        <p class="text-muted" style="font-size: 0.8rem;">Качена на: @Model.UploadedOn</p>
                    </div>

                    <!-- Rating Visuals -->
                    <div class="alert alert-info border-0 shadow-sm text-center mb-4 py-3">
                        <h2 class="fw-bold mb-0">@Model.Rating.ToString("F1") / 5.0</h2>
                        <div class="star-rating-container my-1">
                            <div class="stars-row justify-content-center">
                                @{
                                    int stars = (int)Math.Round(Model.Rating, MidpointRounding.AwayFromZero);
                                }
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="star-shape @(i <= stars ? "star-filled" : "star-empty")" style="font-size: 1.4rem;">★</span>
                                }
                            </div>
                        </div>
                        <small class="text-muted">(@Model.VotesCount гласа)</small>
                    </div>

                    <!-- Vote Section -->
                    <div class="card bg-light border-0 mb-4">
                        <div class="card-body p-3">
                            @if (User.Identity?.IsAuthenticated ?? false)
                            {
                                <h6 class="card-title fw-bold mb-3 text-primary text-center">Твоята оценка</h6>
                                <form method="post" novalidate>
                                    <input type="hidden" name="PhotoId" value="@Model.Id" />

                                    <div class="mb-3">
                                        <select name="Stars" class="form-select form-select-sm border-0 shadow-sm">
                                            <option value="5">⭐⭐⭐⭐⭐ Супер-Мяу!</option>
                                            <option value="4">⭐⭐⭐⭐ Браво-Мяу</option>
                                            <option value="3">⭐⭐⭐ Бива-Мяу</option>
                                            <option value="2">⭐⭐ Слабо-Мяу</option>
                                            <option value="1">⭐ Мяу...</option>
                                        </select>
                                    </div>

                                    <div class="d-flex gap-2">
                                        <button type="submit" asp-action="Vote" class="btn btn-primary btn-sm flex-grow-1 shadow-sm fw-bold">
                                            Гласувай!
                                        </button>
                                        <button type="submit" asp-action="Unvote" asp-route-photoId="@Model.Id"
                                                class="btn btn-outline-danger btn-sm shadow-sm"
                                                title="Премахни моя глас"
                                                onclick="return confirm('Сигурни ли сте, че искате да изтриете гласа си?')">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <div class="py-2 text-center">
                                    <p class="small text-muted mb-3">Влез в профила си, за да гласуваш за тази снимка.</p>
                                    <a asp-area="Identity"
                                       asp-page="/Account/Login"
                                       asp-route-returnUrl="@Context.Request.Path"
                                       class="btn btn-outline-primary btn-sm rounded-pill px-4">
                                        Вход
                                    </a>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Navigation -->
                    <div class="mt-auto pt-3 border-top">
                        <div class="d-flex flex-column gap-1">
                            <a asp-controller="Calendar" asp-action="Month" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                               class="text-muted small text-decoration-none hover-link">
                                <i class="bi bi-calendar3 me-1"></i> Архив за @Model.MonthName @Model.Year
                            </a>
                            <a asp-controller="Cats" asp-action="Details" asp-route-id="@Model.CatId"
                               class="text-muted small text-decoration-none hover-link">
                                <i class="bi bi-collection me-1"></i> Още снимки на @Model.CatName
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>