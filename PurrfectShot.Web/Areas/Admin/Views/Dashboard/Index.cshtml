@using PurrfectShot.Web.ViewModels.Admin
@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Админ Дашборд";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-primary"><i class="bi bi-shield-lock"></i> @ViewData["Title"]</h1>
        <hr class="w-25 mx-auto">
    </div>

    <!-- Tabs / Navigation -->
    <ul class="nav nav-pills nav-fill mb-4 shadow-sm p-1 bg-light rounded-pill" id="adminTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill fw-bold" id="cats-tab" data-bs-toggle="pill" data-bs-target="#cats" type="button" role="tab">
                <i class="bi bi-box-seam me-2"></i>Котки
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill fw-bold" id="photos-tab" data-bs-toggle="pill" data-bs-target="#photos" type="button" role="tab">
                <i class="bi bi-images me-2"></i>Снимки
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill fw-bold" id="users-tab" data-bs-toggle="pill" data-bs-target="#users" type="button" role="tab">
                <i class="bi bi-people me-2"></i>Потребители
            </button>
        </li>
    </ul>

    <!-- Content -->
    <div class="tab-content border rounded-4 shadow-sm bg-white p-4" id="adminTabContent">
        <!-- Cats Panel -->
        <div class="tab-pane fade show active" id="cats" role="tabpanel" aria-labelledby="cats-tab">
            <h4 class="mb-4 text-secondary border-bottom pb-2">Управление на бандата</h4>
            <partial name="_CatsTablePartial" model="Model.Cats" />
        </div>

        <!-- Photo Panel -->
        <div class="tab-pane fade" id="photos" role="tabpanel" aria-labelledby="photos-tab">
            <h4 class="mb-4 text-secondary border-bottom pb-2">Модерация на снимки</h4>
            <partial name="_PhotosTablePartial" model="Model.Photos" />
        </div>

        <!-- Users Panel -->
        <div class="tab-pane fade" id="users" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                <h4 class="mb-0 text-secondary">Управление на потребителите и ролите</h4>

                <a asp-area="Admin" asp-controller="Users" asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm">
                    <i class="bi bi-person-plus-fill me-1"></i> Нов Потребител
                </a>
            </div>

            <partial name="_UsersTablePartial" model="Model.Users" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/admin-dashboard.js" asp-append-version="true"></script>
}