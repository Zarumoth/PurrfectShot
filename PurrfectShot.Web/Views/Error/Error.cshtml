@model PurrfectShot.Web.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "Технически проблем";
}

<div class="container text-center mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <img src="~/images/Cat_Error_500.png" alt="Котка в изгърмял дата център - 500" class="img-fluid mb-4" style="max-width: 300px;">
            <div class="alert alert-danger border-0 rounded-4 shadow-sm p-5">
                <div class="mb-4">
                    <i class="bi bi-exclamation-triangle text-danger" style="font-size: 4rem;"></i>
                </div>
                <h2 class="fw-bold">Опа! Заплетохме кълбото...</h2>
                <p class="mb-4">
                    Възникна неочаквана грешка. Нашите дежурни котки вече гонят мишките в сървъра и ще го оправят скоро.
                </p>

                @if (Model != null && !string.IsNullOrEmpty(Model.RequestId))
                {
                    <div class="bg-white p-2 rounded-3 mb-4">
                        <small class="text-muted font-monospace">ID на грешката: @Model.RequestId</small>
                    </div>
                }

                <a href="/" class="btn btn-danger btn-lg rounded-pill px-5 shadow-sm">
                    Опитай отново
                </a>
            </div>
        </div>
    </div>
</div>