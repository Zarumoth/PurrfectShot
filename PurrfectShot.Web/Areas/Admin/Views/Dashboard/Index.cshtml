@model IEnumerable<PurrfectShot.Web.ViewModels.Cats.CatCardViewModel>

<div class="container mt-5">
    <h2 class="fw-bold text-danger mb-4"><i class="bi bi-speedometer2 me-2"></i>Администрация: Котки</h2>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Име</th>
                            <th>Порода</th>
                            <th class="text-center">Снимки</th>
                            <th class="text-center">Статус</th>
                            <th class="text-end pe-4">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted">#@cat.Id</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@(cat.ProfileImageUrl ?? "/images/Default_Cat_Image.png")"
                                             class="rounded-circle me-2 object-fit-cover"
                                             style="width: 40px; height: 40px;" />
                                        <span class="fw-bold">@cat.Name</span>
                                    </div>
                                </td>
                                <td>@cat.Breed</td>
                                <td class="text-center">
                                    <span class="badge bg-secondary rounded-pill">@cat.PhotoCount</span>
                                </td>
                                <td class="text-center">
                                    @if (cat.IsActive)
                                    {
                                        <span class="badge bg-success">Активна</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Архивирана</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm">
                                        <!-- Profile URL / Redirection -->
                                        <a asp-area="" asp-controller="Cats" asp-action="Details" asp-route-id="@cat.Id"
                                           class="btn btn-sm btn-outline-primary" title="Виж профил">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <!-- Restore if Archived -->
                                        @if (!cat.IsActive)
                                        {
                                            <form asp-area="Admin" asp-controller="Dashboard" asp-action="Restore" asp-route-id="@cat.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Възстанови">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            </form>
                                        }

                                        <!-- Permanent Delete -->
                                        <form asp-area="Admin" asp-controller="Dashboard" asp-action="DeletePermanently" asp-route-id="@cat.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('СИГУРНИ ЛИ СТЕ? Това ще изтрие котката и всичките ѝ снимки ЗАВИНАГИ!');">
                                            <button type="submit" class="btn btn-sm btn-danger" title="Изтрий завинаги">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>