@using Microsoft.AspNetCore.Identity
@using PurrfectShot.Data.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a id="manage" class="nav-link text-primary fw-bold" asp-area="Identity" asp-page="/Account/Manage/Index" title="Твоят профил">
                <i class="bi bi-person-circle"></i> @UserManager.GetUserName(User)
            </a>
        </li>
        <li class="nav-item me-3">
            <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button id="logout" type="submit" class="nav-link btn btn-link text-dark border-0">
                    <i class="bi bi-box-arrow-right"></i> Изход
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item me-2">
            <a class="nav-link text-dark" id="register" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
        </li>
        <li class="nav-item me-3">
            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" id="login" asp-area="Identity" asp-page="/Account/Login">Вход</a>
        </li>
    }
</ul>