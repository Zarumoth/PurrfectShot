@model IEnumerable<PurrfectShot.Web.ViewModels.Photos.PhotoCardViewModel>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th class="ps-4">Превю</th>
                <th>Описание / Модел</th>
                <th class="text-center">Рейтинг</th>
                <th class="text-center">Дата</th>
                <th class="text-end pe-4">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var photo in Model)
            {
                <tr>
                    <td class="ps-4">
                        <img src="@photo.FilePath" class="rounded shadow-sm"
                             style="width: 80px; height: 60px; object-fit: cover;" />
                    </td>
                    <td>
                        <div class="d-flex flex-column">
                            <span class="fw-bold text-dark text-truncate" style="max-width: 250px;">@photo.CatName</span>
                            <small class="text-muted text-wrap" style="max-width: 300px;">@(photo.Caption ?? "Няма описание")</small>
                        </div>
                    </td>
                    <td class="text-center">
                        <span class="text-warning fw-bold">⭐ @photo.Rating.ToString("F1")</span>
                    </td>
                    <td class="text-center small text-muted">
                        @photo.DateUploaded.ToString("dd MMM yyyy")
                    </td>
                    <td class="text-end pe-4">
                        <div class="btn-group">
                            <a asp-area="" asp-controller="Photos" asp-action="Details" asp-route-id="@photo.Id"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-area="" asp-controller="Photos" asp-action="Edit" asp-route-id="@photo.Id"
                               class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil"></i></a>
                            <a asp-area="" asp-controller="Photos" asp-action="Delete" asp-route-id="@photo.Id"
                               class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>