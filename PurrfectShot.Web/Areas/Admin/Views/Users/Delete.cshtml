@model PurrfectShot.Web.ViewModels.Admin.UserListViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-4 border-start border-danger border-5">
                <div class="card-body p-5 text-center">
                    <h2 class="text-danger fw-bold mb-4">⚠️ Изтриване на потребител</h2>
                    <p class="lead">Сигурни ли сте, че искате да премахнете <strong>@Model.UserName</strong>?</p>
                    <p class="text-muted small">Всички котки и снимки, качени от този потребител, ще останат в системата, но той няма да има достъп до тях.</p>

                    <form asp-area="Admin" asp-controller="Users" asp-action="Delete" method="post" class="mt-4">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger btn-lg rounded-pill px-5 shadow-sm">Изтрий акаунта</button>
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" asp-route-tab="users" class="btn btn-link text-muted">Отказ</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>