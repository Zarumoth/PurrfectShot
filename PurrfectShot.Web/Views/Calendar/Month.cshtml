@using System.Globalization
@using PurrfectShot.Web.ViewModels.Photos
@model IEnumerable<PhotoCardViewModel>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary fw-bold">@ViewData["Title"]</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Обратно към Календара</a>
    </div>

    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mt-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Начало</a></li>
            <li class="breadcrumb-item"><a asp-controller="Calendar" asp-action="Index" class="text-decoration-none text-muted">Календар</a></li>
            <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
        </ol>
    </nav>

    @if (!Model.Any())
    {
        <div class="alert alert-light text-center shadow-sm">
            <p class="lead mb-0">Няма качени снимки за този месец 😿</p>
        </div>
    }
    else
    {
        <partial name="_PhotoGridPartial" model="Model" />
    }
</div>