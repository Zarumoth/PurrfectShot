@page
@model IndexModel
@{
    ViewData["Title"] = "Лични данни";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-8">
        <form id="profile-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control" placeholder="Потребителско име" disabled />
                <label asp-for="Username" class="form-label">Потребителско име</label>
            </div>

            <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary rounded-pill shadow-sm">
                Запази промените
            </button>
        </form>
    </div>
</div>